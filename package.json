{
  "name": "clinic-architecture",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "pnpm --parallel --filter patient --filter clerk --filter doctor dev",
    "build": "pnpm --filter patient --filter clerk --filter doctor build",
    "codegen": "pnpm --filter patient --filter clerk --filter doctor codegen",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter '!e2e' test",
    "e2e": "docker compose up -d --wait && docker compose run --rm api bin/rails db:seed && pnpm --filter e2e test",
    "format": "prettier --write \"{apps/patient,apps/clerk,apps/doctor,packages,e2e}/**/*.{ts,tsx,mjs,json}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"{apps/patient,apps/clerk,apps/doctor,packages,e2e}/**/*.{ts,tsx,mjs,json}\" --ignore-path .prettierignore"
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  }
}
